  "functions": [
    {
      "name": "contribution_effects_preserve_basis",
      "security_definer": false,
      "config": null,
      "definition": "CREATE OR REPLACE FUNCTION public.contribution_effects_preserve_basis()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF NEW.document IS DISTINCT FROM OLD.document OR NEW.owner_user_id IS DISTINCT FROM OLD.owner_user_id\n    OR NEW.id IS DISTINCT FROM OLD.id OR NEW.account_id IS DISTINCT FROM OLD.account_id OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN\n    RAISE EXCEPTION 'contribution_effect_basis_immutable';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n"
    },
    {
      "name": "preserve_account_history_review",
      "security_definer": false,
      "config": null,
      "definition": "CREATE OR REPLACE FUNCTION public.preserve_account_history_review()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF TG_OP='DELETE' AND NOT EXISTS (SELECT 1 FROM accounts\n    WHERE id=OLD.account_id AND canonical_owner_user_id=OLD.canonical_owner_user_id) THEN\n    RETURN OLD;\n  END IF;\n  RAISE EXCEPTION 'account_history_review_is_immutable';\nEND $function$\n"
    },
    {
      "name": "preserve_daily_valuation_fx",
      "security_definer": false,
      "config": null,
      "definition": "CREATE OR REPLACE FUNCTION public.preserve_daily_valuation_fx()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  RAISE EXCEPTION 'published daily valuation FX is immutable';\nEND;\n$function$\n"
    }
  ],

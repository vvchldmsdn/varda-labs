  "constraints": [
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_account_id_fkey",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (account_id) REFERENCES accounts(id)"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(document) = 'object'::text) AND (octet_length((document)::text) <= 524288) AND ((document ->> 'version'::text) = 'contribution_effect_v1'::text) AND ((document ->> 'accountId'::text) = (account_id)::text)))"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_owner_user_id_fkey",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_pkey",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (owner_user_id, id)"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_revision_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((revision >= 0))"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_trade_ids_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(trade_ids) = 'array'::text) AND (jsonb_array_length(trade_ids) <= 100)))"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_counts",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((views > 0) AND (visits >= 0) AND (visits <= views)))"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_feature",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((feature)::text = ANY ((ARRAY['home'::character varying, 'today'::character varying, 'structure'::character varying, 'contribution'::character varying, 'lab'::character varying, 'simulation'::character varying, 'history'::character varying, 'manage'::character varying, 'plans'::character varying, 'input'::character varying])::text[])))"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_owner_user_id_activity_date_feature_pk",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (owner_user_id, activity_date, feature)"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_owner_user_id_app_users_id_fk",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "member_activity_profiles",
      "name": "member_activity_profiles_owner_user_id_app_users_id_fk",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "member_activity_profiles",
      "name": "member_activity_profiles_pkey",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (owner_user_id)"
    }
  ],

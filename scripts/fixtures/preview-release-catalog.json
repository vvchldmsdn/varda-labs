  "constraints": [
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_account_id_canonical_owner_user_id_fkey",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (account_id, canonical_owner_user_id) REFERENCES accounts(id, canonical_owner_user_id) ON DELETE CASCADE"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_captured_revision_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((captured_revision >= 0))"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_dates_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((end_date >= start_date) AND ((end_date - start_date) < 366)))"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_evidence_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(evidence) = 'object'::text) AND (evidence @> '{\"basis\": \"reviewed_holdings_excluding_cash\", \"version\": 1, \"currency\": \"KRW\"}'::jsonb)))"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_evidence_hash_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((evidence_hash)::text ~ '^[0-9a-f]{64}$'::text))"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_excluded_labels_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((cardinality(excluded_labels) <= 100) AND (array_position(excluded_labels, NULL::text) IS NULL)))"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_pkey",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (account_id, evidence_hash)"
    },
    {
      "table_name": "account_history_reviews",
      "name": "account_history_reviews_points_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(points) = 'array'::text) AND (jsonb_array_length(points) = ((end_date - start_date) + 1))))"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_account_id_fkey",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (account_id) REFERENCES accounts(id)"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(document) = 'object'::text) AND (octet_length((document)::text) <= 524288) AND ((document ->> 'version'::text) = 'contribution_effect_v1'::text) AND ((document ->> 'accountId'::text) = (account_id)::text)))"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_owner_user_id_fkey",
      "type": "f",
      "validated": true,
      "definition": "FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_pkey",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (owner_user_id, id)"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_revision_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((revision >= 0))"
    },
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_trade_ids_check",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(trade_ids) = 'array'::text) AND (jsonb_array_length(trade_ids) <= 100)))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_cross",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((krw_per_eur > (0)::numeric) AND (krw_per_eur < 'Infinity'::numeric) AND (usd_per_eur > (0)::numeric) AND (usd_per_eur < 'Infinity'::numeric) AND (rate > (0)::numeric) AND (rate = round((krw_per_eur / NULLIF(usd_per_eur, (0)::numeric)), 2))))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_day_pair",
      "type": "u",
      "validated": true,
      "definition": "UNIQUE (service_date, base_currency, quote_currency)"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_kind",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((evidence_kind = ANY (ARRAY['closing_reference'::text, 'historical_reconstruction'::text])))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_pair",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((((base_currency)::text = 'USD'::text) AND ((quote_currency)::text = 'KRW'::text)))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_pkey",
      "type": "p",
      "validated": true,
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_reference",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((reference_date >= (service_date - 7)) AND (reference_date <= (service_date - 1))))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_source",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((source = 'ecb_eur_cross'::text) AND (policy = 'ecb-eur-cross-2dp-prev-market-day-v1'::text)))"
    },
    {
      "table_name": "daily_valuation_fx",
      "name": "daily_valuation_fx_time",
      "type": "c",
      "validated": true,
      "definition": "CHECK ((fetched_at >= ((service_date + '07:00:00'::time without time zone) AT TIME ZONE 'Asia/Seoul'::text)))"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_counts",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((views > 0) AND (visits >= 0) AND (visits <= views)))"
    },
    {
      "table_name": "member_activity_daily",
      "name": "member_activity_daily_feature",
      "type": "c",
      "validated": true,
      "definition": "CHECK (((feature)::text = ANY ((ARRAY['home'::character varying, 'today'::character varying, 'structure'::character varying, 'contribution'::character varying, 'lab'::character varying, 'simulation'::character varying, 'history'::character varying, 'manage'::character varying, 'plans'::character varying, 'input'::character varying])::text[])))"
    },
    {
      "table_name": "member_activity_daily",

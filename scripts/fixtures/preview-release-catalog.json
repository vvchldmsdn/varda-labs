  "policies": [
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_tenant_v1",
      "permissive": "PERMISSIVE",
      "roles": "{varda_tenant_app}",
      "cmd": "ALL",
      "qual": "((owner_user_id = (NULLIF(current_setting('app.current_user_id'::text, true), ''::text))::uuid) AND investment_plan_tenant_active())",
      "with_check": "((owner_user_id = (NULLIF(current_setting('app.current_user_id'::text, true), ''::text))::uuid) AND investment_plan_tenant_active() AND (EXISTS ( SELECT 1\n   FROM accounts a\n  WHERE ((a.id = contribution_effects.account_id) AND (a.canonical_owner_user_id = contribution_effects.owner_user_id) AND a.is_active))))"
    }
  ],
  "triggers": [
    {
      "table_name": "contribution_effects",
      "name": "contribution_effects_preserve_basis",
      "enabled": "O",
      "definition": "CREATE TRIGGER contribution_effects_preserve_basis BEFORE UPDATE ON public.contribution_effects FOR EACH ROW EXECUTE FUNCTION contribution_effects_preserve_basis()"
    }
  ],
  "functions": [
    {
      "name": "contribution_effects_preserve_basis",
      "security_definer": false,
      "config": null,
      "definition": "CREATE OR REPLACE FUNCTION public.contribution_effects_preserve_basis()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF NEW.document IS DISTINCT FROM OLD.document OR NEW.owner_user_id IS DISTINCT FROM OLD.owner_user_id\n    OR NEW.id IS DISTINCT FROM OLD.id OR NEW.account_id IS DISTINCT FROM OLD.account_id OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN\n    RAISE EXCEPTION 'contribution_effect_basis_immutable';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n"
    }
  ],
